{
  "name": "nuxt-belot",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "elysia": "^1.4.0",
      "@elysiajs/eden": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "better-auth": "^1.7.7",
      "drizzle-orm": "^0.44.0"
    }
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@belot/server' --filter '@belot/web' dev",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
