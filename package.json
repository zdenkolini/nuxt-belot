{
  "name": "nuxt-belot",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "elysia": "^1.4.0",
      "@elysiajs/eden": "^1.4.0",
      "@elysiajs/cors": "^1.4.0",
      "better-auth": "^1.7.7",
      "drizzle-orm": "^0.45.4"
    }
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@belot/server' --filter '@belot/web' dev",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005"
  }
}
