{
  "name": "@belot/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "bun --bun svelte-kit sync || echo ''",
    "typecheck": "bun --bun paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@belot/engine": "workspace:*",
    "@belot/server": "workspace:*",
    "@elysiajs/eden": "catalog:",
    "@tanstack/svelte-query": "^6.3.1",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.18.2",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.18.0",
    "cn": "^0.4.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
